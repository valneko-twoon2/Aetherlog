#!/bin/sh
# Rejects staged documentation or source comments that are not English.
python "$(dirname "$0")/check_agent_mirror.py" || exit $?
files=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$files" ] && exit 0
# shellcheck disable=SC2086
exec python "$(dirname "$0")/check_english.py" files $files
