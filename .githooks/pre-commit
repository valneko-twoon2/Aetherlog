#!/bin/sh
# Rejects staged documentation or source comments that are not English.
python "$(dirname "$0")/check_agent_mirror.py" || exit $?
files=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$files" ] && exit 0
# The licence notices list every bundled package: regenerate them when the dependencies change.
if echo "$files" | grep -qE '^(src-tauri/Cargo\.(toml|lock)|web/package(-lock)?\.json|tools/make_notices\.mjs)$'; then
    root=$(git rev-parse --show-toplevel)
    node "$root/tools/make_notices.mjs" --check || exit 1
    if ! git diff --quiet -- THIRD-PARTY-NOTICES.txt src-tauri/notices.json; then
        echo "THIRD-PARTY-NOTICES.txt and src-tauri/notices.json have unstaged changes: stage them with the dependency change." >&2
        exit 1
    fi
fi
# shellcheck disable=SC2086
exec python "$(dirname "$0")/check_english.py" files $files
